#!/usr/bin/env bash
# Blocks `git push` unless server (Unit + Feature) and browser tests pass.
# Bypass in an emergency with: git push --no-verify
set -euo pipefail

# GUI git clients don't source ~/.bashrc, so add the Flock (php, node) and pnpm shims explicitly.
for dir in "$HOME/.local/share/pnpm/bin" "$HOME/.local/share/flock/node-global/current/bin" "$HOME/.local/share/flock/bin"; do
    if [ -d "$dir" ]; then
        PATH="$dir:$PATH"
    fi
done
export PATH

cd "$(git rev-parse --show-toplevel)"

echo "pre-push: running server tests (Unit + Feature)..."
php artisan config:clear --quiet
vendor/bin/pest tests/Unit tests/Feature --compact

echo "pre-push: building assets for browser tests..."
pnpm run build >/dev/null

echo "pre-push: running browser tests..."
vendor/bin/pest tests/Browser --compact

echo "pre-push: all tests passed."
